#!/bin/sh
# Run Offline Librarian's application checks; bin/check --full calls this after the foundation checks.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
python=${OFFLINE_LIBRARIAN_PYTHON:-.venv/bin/python}
if [ ! -x "$python" ]; then
  echo "Offline Librarian isn't set up yet: run bin/setup." >&2
  exit 1
fi
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" "$python" -B -W error::ResourceWarning tests/run.py discover -s tests
