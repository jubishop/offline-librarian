#!/bin/sh
# Run the librarian command from this checkout. Set OFFLINE_LIBRARIAN_PYTHON to choose the Python.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "${OFFLINE_LIBRARIAN_PYTHON:-python3}" -B -m librarian "$@"
