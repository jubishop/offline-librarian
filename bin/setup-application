#!/bin/sh
# Install Offline Librarian's Python and packages into .venv from uv.lock; bin/setup runs this.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if ! command -v uv >/dev/null 2>&1; then
  echo "Offline Librarian needs uv to install its Python and packages: https://docs.astral.sh/uv/" >&2
  exit 1
fi
if ! command -v pdftotext >/dev/null 2>&1; then
  echo "Offline Librarian needs pdftotext to read PDFs: install poppler (brew install poppler)." >&2
  exit 1
fi
uv sync --frozen
